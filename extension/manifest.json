{
  "manifest_version": 3,
  "name": "YouTube Downloader",
  "version": "2.5.0",
  "description": "__MSG_description__",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.googlevideo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "settings.js",
        "i18n.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "settings.js",
        "i18n.js",
        "shared.js",
        "background_content.js",
        "quality_content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "102",
  "default_locale": "en",
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}